// "saltwind" — coastal watchtower at dusk, tide going out
// D dorian (the raised B gives it salt), koto phrases, a buoy bell far off
// same long-form engine: coprime cycles + perlin, repeat period >> mix
// (waves and gull cries are yours to add)

setcps(.4) // 1 cycle = 2.5s

stack(

  // ---- TIDE FLOOR — D+A pedal ----
  note("<[d2,a2] [d2,a2] [f1,c2] [d2,a2] [d2,a2] [c2,g2] [d2,a2] [g1,d2]>/6")
    .s("sine")
    .attack(4).sustain(1).release(7)
    .gain(.65)
    .lpf(perlin.range(120, 300).slow(11))
  ,

  // fretless bass — swells like the water line moving
  note("<[d2] [~] [a2] [~] [f2] [~] [c3] [~] [g2] [~]>/3")
    .s("gm_fretless_bass")
    .attack(1.5).sustain(.8).release(3)
    .degradeBy(.25)
    .gain(perlin.range(.3, .55).slow(13))
    .lpf(perlin.range(250, 600).slow(9))
    .room(.5).size(4)
  ,

  // ---- PADS — 8 chords of D dorian, grey-gold water ----
  note(`<
    [d3,f3,a3,c4,e4] [f3,a3,c4,e4] [a2,c3,e3,g3] [g3,b3,d4,e4]
    [d3,f3,a3,c4,e4] [c3,e3,g3,b3] [e3,g3,b3,d4] [g2,b2,d3,f3]
  >/6`)
    .s("gm_pad_bowed")
    .attack(3).release(6)
    .jux(rev)
    .gain(perlin.range(.2, .45).slow(7))
    .lpf(perlin.range(350, 950).slow(17))
    .room(.8).size(7) // open horizon
  ,

  // ---- KOTO — plucked phrases off the tower balcony ----
  n("<[0 ~ 2 4] [~ 3 ~ 2] [5 ~ 4 ~] [~ 0 ~ ~] [7 5 ~ 4] [2 ~ ~ 0]>"
      .add("<0 2 4 -2 1 3 0>/29"))
    .slow(2)
    .scale("D4:minor:pentatonic")
    .s("gm_koto")
    .sometimesBy(.2, x => x.add(note(12)))
    .degradeBy(.3)
    .gain(perlin.range(.5, .85).slow(8))
    .attack(.01).release(1.3)
    .pan(rand.range(.3, .7))
    .delay(.3).delaytime(.75).delayfeedback(.3)
    .lpf(2800)
    .room(.6).size(5)
    .mask("<1 1 1 0 1 1 1 1 0 1 1>/9")
  ,

  // ---- BOTTLE — wind across the railing, long airy notes ----
  n("<[~ ~ 4 ~] [~ 5 ~ ~] [7 ~ ~ ~] [~ ~ ~ 5] [~ 4 ~ 2] [~ ~ ~ ~]>"
      .add("<0 2 0 1 -2>/31"))
    .slow(4)
    .scale("D5:minor:pentatonic")
    .s("gm_blown_bottle")
    .degradeBy(.35)
    .attack(.6).sustain(.7).release(2.5)
    .gain(perlin.range(.25, .5).slow(10))
    .pan(sine.range(.3, .7).slow(19))
    .delay(.3).delaytime(1.5).delayfeedback(.3)
    .lpf(2000)
    .room(.8).size(7)
    .mask("<0 1 1 1 0 1 1 1 1 0 1 1 1>/13")
  ,

  // ---- BUOY BELL — far out in the channel, rocks when it wants ----
  note("<d4 a4>/8")
    .struct("<[x ~ ~ ~] [~ ~ ~ ~] [~ ~ ~ ~] [~ x ~ ~] [~ ~ ~ ~]>/3")
    .s("gm_tubular_bells")
    .degradeBy(.4)
    .gain(rand.range(.1, .25)) // distant
    .attack(.01).release(4)
    .pan(sine.range(.6, .85).slow(29)) // drifts off starboard
    .lpf(1400)
    .room(.9).size(9)
    .mask("<1 0 1 1 0 1 1 0 1 1 1>/11")
  ,

  // ---- SPRAY — vibraphone flecks, random pentatonic ----
  n(irand(8)).segment(8)
    .scale("D5:minor:pentatonic")
    .s("gm_vibraphone")
    .degradeBy(.87)
    .gain(rand.range(.12, .28))
    .pan(rand)
    .attack(.02).release(2)
    .delay(.35).delaytime("3/8").delayfeedback(.4)
    .lpf(rand.range(1800, 4000))
    .room(.8).size(7)
)
._scope()
