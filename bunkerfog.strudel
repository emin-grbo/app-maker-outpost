// "bunker fog" v2
samples('github:emin-grbo/app-maker--outpost')
samples('github:eddyflux/crate')

setcps(.5)

let pads = chord("<Fmaj9 Cmaj7 Am9 Em11>/4").dict('ireal')
stack(

 //  RADIO QUOTES - rare, plays full sample
 s("steveQuotes").n(irand(2))
   .struct("<0 0 0 1 0 0 0 0>/8")
   .lpf(2500).hpf(300)            // radio band-pass
   .shape(.3)                      // slight crunch = radio distortion
   .gain(.8)
   .speed(rand.range(.9, 1.1))    // slight pitch wobble
   .pan(rand)                      // random stereo placement
   .cut(1)                         // cuts previous quote if new one triggers
   ,
    
note("[D3, A3, D4, F#4] [G3, B3, D4, G4] [Bm3, F#3, B3, D4] [A3, E4, A4, C#5]")
  .room(2).size(.2)
  .jux(rev)
  .slow(8)
  .sustain(5)
  .sound("gm_choir_aahs")
  .attack(.5)
  .release(.8)
  .lpf(sine.range(500, 1400))
,

note("<C5 E5 G5 B5 D6>*8?")
  .s("gm_glockenspiel")
  .slow(10)
  .gain(5)
  //.gain(rand.range(0.4, 0.54))
  .pan(rand.range(-0.6, 0.6))
  .attack(0.1)
  .decay(0.3)
  //.sustain(1)
  .release(rand.range(0.4, 1.2))
  .room(0.8)
  .size(3)
  .delay(0.25)
  .delaytime("3/8")
  .delayfeedback(0.25)
  .lpf(rand.range(1200, 3500))
  ,
  
  stack(
    s("gm_seashore")
      .loopAt(8)
      .gain(.7)
      .lpf(1500).hpf(400)
    ,
    s("gm_breath_noise")
      .loopAt(4)
      .gain(.5)
      .lpf(1200).hpf(600)
      .pan(sine.range(.3, .7).slow(6))
      .degradeBy(.3)
    ,
    s("gm_helicopter")
      .mask("<1 0 0 0 1 0 0 0>/4")
      .degradeBy(.3)
      .speed(.5)
      .lpf(800)
      .gain(.5)
      .room(.3).size(2)
    )
)
.late("[0 .005]*2")
._scope()

