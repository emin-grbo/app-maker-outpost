// "canopy" — treehouse research platform in the rainforest crown, humid midday
// G major, wood on wood — marimba and kalimba trading, frogs keeping time badly
// same long-form engine: coprime cycles + perlin, repeat period >> mix
// (insect wall and bird calls are yours to add)

setcps(.48)

stack(

  // ---- TRUNK — G+D pedal, the tree carrying everything ----
  note("<[g1,d2] [g1,d2] [c2,g2] [g1,d2] [g1,d2] [e1,b1] [g1,d2] [a1,e2]>/6")
    .s("sine")
    .attack(3).sustain(1).release(6)
    .gain(.55)
    .lpf(perlin.range(120, 300).slow(11))
  ,

  // green mass — a thousand leaves breathing
  note("<[g2,d3] [g2,d3] [c3,g3] [g2,d3] [g2,d3] [e2,b2] [g2,d3] [a2,e3]>/6")
    .s("gm_pad_new_age")
    .attack(2.5).release(5)
    .gain(perlin.range(.2, .42).slow(13))
    .lpf(perlin.range(400, 1100).slow(9))
    .room(.6).size(5)
  ,

  // ---- PADS — G major, damp and bright at once ----
  note(`<
    [g2,b2,d3,f#3,a3] [c3,e3,g3,b3] [e3,g3,b3,d4] [a2,c3,e3,g3]
    [g2,b2,d3,f#3,a3] [d3,f#3,a3,c4] [c3,e3,g3,b3] [e3,g3,b3]
  >/6`)
    .s("gm_pad_warm")
    .attack(2).release(4)
    .jux(rev)
    .gain(perlin.range(.2, .4).slow(7))
    .lpf(perlin.range(500, 1300).slow(17))
    .room(.6).size(5)
  ,

  // ---- MARIMBA — the main voice, wooden and warm ----
  n("<[0 2 ~ 4] [~ 3 2 ~] [5 ~ 4 2] [~ 0 ~ 4] [7 5 ~ ~] [2 ~ 4 0]>"
      .add("<0 2 4 -2 1 0 3>/29"))
    .slow(2)
    .scale("G3:major:pentatonic")
    .s("gm_marimba")
    .sometimesBy(.2, x => x.add(note(12)))
    .degradeBy(.3)
    .gain(perlin.range(.5, .8).slow(8))
    .attack(.01).release(1)
    .pan(rand.range(.3, .7))
    .delay(.25).delaytime(.66).delayfeedback(.25)
    .lpf(2600)
    .room(.5).size(4)
    .mask("<1 1 1 0 1 1 1 1 0 1 1>/9")
  ,

  // ---- KALIMBA — answering from the next platform over ----
  n("<[~ 0 ~ 2] [1 ~ ~ ~] [~ 3 ~ 0] [~ ~ 4 ~]>"
      .add("<0 -2 2 1 0>/31"))
    .slow(3)
    .scale("G4:major:pentatonic")
    .s("gm_kalimba")
    .degradeBy(.4)
    .gain(.45)
    .pan(rand.range(.25, .75))
    .delay(.3).delaytime(1).delayfeedback(.3)
    .lpf(2200)
    .room(.5).size(4)
    .mask("<1 1 0 1 1 1 0>/7")
  ,

  // ---- OCARINA — something calling across the canopy, rare ----
  n("<[~ ~ 4 ~] [~ ~ ~ ~] [5 ~ ~ ~] [~ 7 ~ ~] [~ ~ ~ 4] [~ ~ ~ ~]>"
      .add("<0 2 0 1 -2>/23"))
    .slow(4)
    .scale("G5:major:pentatonic")
    .s("gm_ocarina")
    .degradeBy(.35)
    .attack(.3).sustain(.6).release(1.5)
    .gain(perlin.range(.2, .4).slow(10))
    .pan(rand.range(.2, .8))
    .delay(.35).delaytime(1.5).delayfeedback(.35)
    .lpf(2400)
    .room(.8).size(7)
    .mask("<0 1 1 1 0 1 1 1 1 0 1 1 1>/13")
  ,

  // ---- FROGS — woodblock ticks, terrible sense of rhythm ----
  s("gm_woodblock")
    .struct("~ x ~ ~ x ~ ~ ~")
    .degradeBy(.65)
    .speed(rand.range(.9, 1.4)) // different frogs
    .gain(rand.range(.08, .2))
    .pan(rand)
    .lpf(1800)
    .room(.6).size(5)
    .mask("<1 0 1 1 1 0 1 1 0 1 1>/11")
  ,

  // ---- SUNSPOTS — light through moving leaves ----
  n(irand(8)).segment(8)
    .scale("G5:major:pentatonic")
    .s("gm_celesta")
    .degradeBy(.86)
    .gain(rand.range(.1, .25))
    .pan(rand)
    .attack(.01).release(1.2)
    .delay(.3).delaytime("3/8").delayfeedback(.35)
    .lpf(rand.range(2000, 4500))
    .room(.6).size(5)
)
._scope()
