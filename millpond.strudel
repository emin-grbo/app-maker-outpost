// "millpond" — old watermill at dawn, wheel turning for nobody
// A major, harp ripples and an oboe like a duck deciding things
// same long-form engine: coprime cycles + perlin, repeat period >> mix

setcps(.45)

stack(

  // ---- POND — A+E pedal, still water holding the sky ----
  note("<[a1,e2] [a1,e2] [d2,a2] [a1,e2] [a1,e2] [f#1,c#2] [a1,e2] [e2,b2]>/6")
    .s("sine")
    .attack(3.5).sustain(1).release(6)
    .gain(.55)
    .lpf(perlin.range(110, 270).slow(11))
  ,

  // millrace — water sliding over the weir, constant and soft
  note("<[a2,e3] [a2,e3] [d3,a3] [a2,e3] [a2,e3] [f#2,c#3] [a2,e3] [e3,b3]>/6")
    .s("gm_pad_new_age")
    .attack(3).release(5)
    .gain(perlin.range(.2, .42).slow(13))
    .lpf(perlin.range(400, 1000).slow(9))
    .room(.6).size(5)
  ,

  // ---- PADS — A major, first light through the alders ----
  note(`<
    [a2,c#3,e3,g#3,b3] [d3,f#3,a3,c#4] [f#3,a3,c#4,e4] [e3,g#3,b3,d#4]
    [a2,c#3,e3,g#3,b3] [b2,d3,f#3,a3] [d3,f#3,a3] [e3,g#3,b3]
  >/6`)
    .s("gm_pad_warm")
    .attack(2.5).release(5)
    .jux(rev)
    .gain(perlin.range(.2, .4).slow(7))
    .lpf(perlin.range(450, 1200).slow(17))
    .room(.6).size(5)
  ,

  // ---- WHEEL — the old wheel turning: slow wooden knock, almost regular ----
  s("gm_woodblock")
    .struct("x ~ ~ ~ ~ ~ ~ ~")
    .degradeBy(.15)
    .speed(rand.range(.42, .48)) // each blade lands a little different
    .gain(rand.range(.1, .18))
    .pan(.3)
    .lpf(500)
    .room(.5).size(4)
    .mask("<1 1 1 1 0 1 1>/7")
  ,

  // ---- HARP — rings spreading where the wheel drops water ----
  n("<[0 2 4 ~] [~ 3 ~ 2] [5 ~ 4 2] [~ 0 ~ 4] [7 5 ~ ~] [2 ~ 4 0]>"
      .add("<0 2 4 -2 1 0 3>/29"))
    .slow(2)
    .scale("A3:major:pentatonic")
    .s("gm_orchestral_harp")
    .sometimesBy(.2, x => x.add(note(12)))
    .degradeBy(.3)
    .gain(perlin.range(.45, .75).slow(8))
    .attack(.01).release(1.5)
    .pan(rand.range(.3, .7))
    .delay(.3).delaytime(.66).delayfeedback(.3)
    .lpf(2800)
    .room(.6).size(5)
    .mask("<1 1 1 0 1 1 1 1 0 1 1>/9")
  ,

  // ---- OBOE — reedy, deliberate, somewhere in the rushes ----
  n("<[~ ~ 2 ~] [4 ~ ~ ~] [~ 5 ~ 4] [~ ~ ~ ~] [2 ~ ~ 0] [~ ~ ~ ~]>"
      .add("<0 2 0 -2 1>/23"))
    .slow(3)
    .scale("A4:major:pentatonic")
    .s("gm_oboe")
    .degradeBy(.35)
    .attack(.3).sustain(.6).release(1.5)
    .gain(perlin.range(.2, .4).slow(10))
    .pan(.62)
    .lpf(1800)
    .room(.6).size(5)
    .mask("<0 1 1 1 0 1 1 1 1 0 1 1 1>/13")
  ,

  // ---- GUITAR — the miller's chair by the door, half-remembered ----
  n("<[~ 0 ~ 2] [1 ~ ~ ~] [~ ~ 3 0] [~ 4 ~ ~]>"
      .add("<0 -2 2 1 0>/31"))
    .slow(3)
    .scale("A2:major:pentatonic")
    .s("gm_acoustic_guitar_nylon")
    .degradeBy(.4)
    .gain(.45)
    .attack(.02).release(1.2)
    .pan(rand.range(.35, .65))
    .delay(.25).delaytime(1).delayfeedback(.2)
    .lpf(1800)
    .room(.5).size(4)
    .mask("<1 1 0 1 1 1 0>/7")
  ,

  // ---- MIDGES — dawn light catching wings over the water ----
  n(irand(8)).segment(8)
    .scale("A5:major:pentatonic")
    .s("gm_celesta")
    .degradeBy(.86)
    .gain(rand.range(.1, .24))
    .pan(rand)
    .attack(.01).release(1.2)
    .delay(.3).delaytime("3/8").delayfeedback(.35)
    .lpf(rand.range(2000, 4500))
    .room(.6).size(5)
)
._scope()
